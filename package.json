{
  "name": "visaradar-cn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "launch:readiness": "node --no-warnings --experimental-strip-types scripts/launch-readiness.ts",
    "deploy:validate": "node --no-warnings --experimental-strip-types scripts/validate-vercel-prep.ts",
    "db:validate": "vitest run tests/schema.test.ts tests/local-repository.test.ts",
    "db:production:validate": "node --no-warnings --experimental-strip-types scripts/validate-production-db.ts",
    "etl:validate": "python3 -m etl.cli validate-manifest --manifest data/source_manifest.json",
    "etl:fingerprint": "python3 -m etl.cli fingerprint --path data/fixtures/raw/oflc_lca_fy2026_q2.csv",
    "etl:fixtures": "python3 -m etl.cli download --manifest data/source_manifest.json --log data/etl_runs/local.jsonl --fixtures-only",
    "etl:lca:fixture": "python3 -m etl.cli parse-lca --input data/fixtures/raw/oflc_lca_fy2026_q2.csv --source-id oflc_lca_fy2026_q2 --fiscal-year 2026 --output data/normalized/h1b_lca_records.jsonl",
    "etl:lca:fixtures": "python3 -m etl.cli parse-lca-manifest --manifest data/source_manifest.json --output data/normalized/h1b_lca_records.jsonl --fixtures-only",
    "etl:perm:fixture": "python3 -m etl.cli parse-perm --input data/fixtures/raw/oflc_perm_fy2026_q2.csv --source-id oflc_perm_fy2026_q2 --fiscal-year 2026 --output data/normalized/perm_records.jsonl",
    "etl:perm:fixtures": "python3 -m etl.cli parse-perm-manifest --manifest data/source_manifest.json --output data/normalized/perm_records.jsonl --fixtures-only",
    "etl:pwd:fixture": "python3 -m etl.cli parse-pwd --input data/fixtures/raw/oflc_pwd_fy2026_q2.csv --source-id oflc_pwd_fy2026_q2 --effective-year 2026 --data-series \"DOL OFLC Prevailing Wage Disclosure Data\" --output data/normalized/pwd_records.jsonl",
    "etl:pwd:fixtures": "python3 -m etl.cli parse-pwd-manifest --manifest data/source_manifest.json --output data/normalized/pwd_records.jsonl --fixtures-only",
    "etl:uscis:h1b:fixture": "python3 -m etl.cli parse-uscis-h1b --input data/fixtures/raw/uscis_h1b_employer_data_fy2023.csv --source-id uscis_h1b_employer_data_fy2023 --fiscal-year 2023 --output data/normalized/uscis_h1b_employer_records.jsonl",
    "etl:uscis:h1b:fixtures": "python3 -m etl.cli parse-uscis-h1b-manifest --manifest data/source_manifest.json --output data/normalized/uscis_h1b_employer_records.jsonl --fixtures-only",
    "etl:visa:bulletin:fixtures": "python3 -m etl.cli parse-visa-bulletin-manifest --manifest data/source_manifest.json --output data/normalized/visa_bulletin_dates.jsonl --fixtures-only",
    "etl:uscis:filing-chart:fixtures": "python3 -m etl.cli parse-uscis-filing-chart-manifest --manifest data/source_manifest.json --output data/normalized/uscis_filing_charts.jsonl --fixtures-only",
    "etl:companies:fixtures": "python3 -m etl.cli build-company-candidates --lca data/normalized/h1b_lca_records.jsonl --perm data/normalized/perm_records.jsonl --uscis-h1b data/normalized/uscis_h1b_employer_records.jsonl --manual-aliases data/manual/employer_alias_seeds.json --employers-output data/normalized/employers.jsonl --aliases-output data/normalized/employer_aliases.jsonl --output data/normalized/company_page_candidates.jsonl",
    "etl:test": "python3 -m unittest discover -s tests/etl -p 'test_*.py'",
    "seo:audit": "node --no-warnings --experimental-strip-types scripts/seo-audit.ts",
    "data:freshness": "node --no-warnings --experimental-strip-types scripts/data-freshness.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.14",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
