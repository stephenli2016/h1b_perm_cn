NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
LOCAL_DATA_MODE=fixture

# M27 deployment safety. Set true in Vercel Preview or private test deployments
# to emit noindex metadata, disallow robots, and suppress sitemap URLs.
PRELAUNCH_NOINDEX=false

# Optional M25 analytics, webmaster, and monitoring placeholders.
# Leave blank to keep local development fully functional without third-party scripts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_ERROR_MONITORING_ENDPOINT=
NEXT_PUBLIC_ERROR_MONITORING_ENVIRONMENT=development
NEXT_PUBLIC_RELEASE_SHA=local

# Local development can run without a production database in early milestones.
# Keep LOCAL_DATA_MODE=fixture to avoid any Supabase dependency.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visaradar_cn

# Supabase placeholders for later production milestones. Do not commit real keys.
# SUPABASE_ANON_KEY is publishable only when RLS/grants are configured for that use.
# SUPABASE_SERVICE_ROLE_KEY is server-side only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-server-only
